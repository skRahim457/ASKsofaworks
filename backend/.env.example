# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/asksofaworks?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=your_custom_jwt_signing_secret_here

# Local Server Port (Defaults to 5000)
PORT=5000

# Firebase Authentication (Optional, for phone OTP verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
